<UserControl x:Class="WinCleaner.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- 제목 -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="새로고침" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
                <StackPanel>
                    <TextBlock Text="대시보드" Style="{StaticResource PageTitle}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}">
                        <Run Text="{Binding OsDescription, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding PrivilegeText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- 권장 작업 -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,0" BorderBrush="{StaticResource DangerBrush}"
                    Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="디스크 청소로 이동" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="OpenCleaningButton"
                            Margin="16,0,0,0" Command="{Binding OpenCleaningCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="권장 작업" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 드라이브 -->
            <TextBlock Text="드라이브" Style="{StaticResource SectionTitle}" Margin="0,28,0,12" />
            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Label}"
                                               Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </DockPanel>
                                <ProgressBar x:Name="Bar" Value="{Binding UsedPercent, Mode=OneWay}"
                                             Style="{StaticResource UsageBar}" Margin="0,14,0,12" />
                                <TextBlock Text="{Binding UsageText}" Style="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="Free" Text="{Binding FreeText}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLowOnSpace}" Value="True">
                                <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter TargetName="Free" Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 메모리 -->
            <TextBlock Text="메모리" Style="{StaticResource SectionTitle}" Margin="0,16,0,12" />
            <UniformGrid Columns="2" Margin="0,0,-12,0">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" DataContext="{Binding Memory}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercentText}"
                                       Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <TextBlock Text="물리 메모리" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </DockPanel>
                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Style="{StaticResource UsageBar}"
                                     Margin="0,14,0,12" />
                        <TextBlock Text="{Binding UsageText}" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding AvailableText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"
                       Text="Windows는 남는 메모리를 캐시로 쓰기 때문에 사용률이 높아도 정상일 수 있습니다." />

        </StackPanel>
    </ScrollViewer>
</UserControl>
