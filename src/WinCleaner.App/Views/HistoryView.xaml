<UserControl x:Class="WinCleaner.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28,32,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="기록" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       AutomationProperties.AutomationId="StatusText" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                         Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <!-- 시스템 복원 지점 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="지금 만들기" Command="{Binding CreateRestorePointCommand}" Style="{StaticResource SecondaryButton}"
                                IsEnabled="{Binding CanManageRestorePoints}" Margin="0,0,8,0" />
                        <Button Content="시스템 복원 열기" Command="{Binding OpenSystemRestoreCommand}" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="시스템 복원 지점" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding RestorePointText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="WinCleaner의 되돌리기로 해결되지 않으면 '시스템 복원 열기'로 Windows를 이전 시점으로 돌릴 수 있습니다." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="한 일" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SecondaryText}" Text="아직 기록이 없습니다. 정리하거나 설정을 바꾸면 여기에 남습니다." />
            </Border>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
            <ListBox ItemsSource="{Binding Entries}" ItemContainerStyle="{StaticResource PlainListItem}"
                     Background="Transparent" BorderThickness="0" IsEnabled="{Binding IsIdle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                     AutomationProperties.AutomationId="HistoryList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Border Background="{StaticResource BadgeBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{StaticResource HintBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="기록 보기" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,0,8,0"
                                        Visibility="{Binding HasLog, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.OpenLogCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="되돌리기" Style="{StaticResource PrimaryButton}" Padding="12,5"
                                        Visibility="{Binding CanRevert, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
