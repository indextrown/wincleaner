<UserControl x:Class="WinCleaner.App.Views.DiskUsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <!-- 제목 -->
        <DockPanel DockPanel.Dock="Top" Margin="32,28,32,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="DisplayText"
                          IsEnabled="{Binding IsIdle}" MinWidth="200" Height="34" VerticalContentAlignment="Center"
                          Margin="0,0,10,0" AutomationProperties.AutomationId="DriveList" />
                <Grid>
                    <Button Content="분석" MinWidth="96" Command="{Binding AnalyzeCommand}"
                            Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="AnalyzeButton"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="취소" MinWidth="96" Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButton}" AutomationProperties.AutomationId="CancelButton"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="용량 분석" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0" AutomationProperties.AutomationId="StatusText" />
            </StackPanel>
        </DockPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="32,6,32,0"
                     Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- 분석 전 안내 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="32,16,32,0"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="28"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="무엇이 드라이브를 차지하는지 찾아봅니다" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="드라이브 전체를 훑어 폴더별 크기와 가장 큰 파일 200개를 보여 줍니다. 폴더 이름을 누르면 안으로 들어가고, 탐색기 버튼으로 실제 위치를 열 수 있습니다. 관리자 권한으로 실행하면 더 많은 폴더를 확인할 수 있습니다." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 분석 결과 -->
        <DockPanel Margin="32,12,32,24" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">

            <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,-12,0">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="드라이브 사용 중" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding UsedText}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="분석한 크기" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding AnalyzedText}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="열 수 없는 폴더" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding InaccessibleText}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding InaccessibleText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock DockPanel.Dock="Top" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                       Style="{StaticResource SecondaryText}"
                       Text="열 수 없는 폴더는 크기에 들어가지 않고, Windows 폴더는 하드 링크 때문에 실제보다 크게 보일 수 있습니다. 그래서 두 숫자가 다를 수 있습니다." />

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,8">
                <RadioButton Content="폴더별 용량" GroupName="DiskUsageTab" IsChecked="{Binding ShowFolders}"
                             Style="{StaticResource TabButton}" AutomationProperties.AutomationId="FoldersTab" />
                <RadioButton Content="가장 큰 파일" GroupName="DiskUsageTab" IsChecked="{Binding ShowLargeFiles}"
                             Style="{StaticResource TabButton}" AutomationProperties.AutomationId="LargeFilesTab" />
            </StackPanel>

            <Grid>
                <!-- 폴더별 용량 -->
                <DockPanel Visibility="{Binding ShowFolders, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="위로" Command="{Binding GoUpCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="12,5" />
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Separator" Text="›" Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Button Content="{Binding Name}" Style="{StaticResource LinkButton}" FontSize="14"
                                                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Node}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <ListBox ItemsSource="{Binding FolderRows}" ItemContainerStyle="{StaticResource PlainListItem}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.AutomationId="FolderList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Foreground="{StaticResource FolderBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Button Content="{Binding Name}" Style="{StaticResource LinkButton}" FontSize="14"
                                                    HorizontalAlignment="Left" IsEnabled="{Binding CanOpen}"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" AutomationProperties.AutomationId="FolderLink" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource HintBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <ProgressBar Grid.Column="2" Value="{Binding Percent, Mode=OneWay}"
                                                     Style="{StaticResource UsageBar}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="13"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="4" Text="{Binding PercentText}" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Button Grid.Column="5" Content="&#xEC50;" Style="{StaticResource IconButton}"
                                                HorizontalAlignment="Right" ToolTip="탐색기에서 열기"
                                                Visibility="{Binding HasPath, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding Path}" />
                                        <Button Grid.Column="6" Content="&#xE74D;" Style="{StaticResource IconButton}"
                                                HorizontalAlignment="Right" ToolTip="{Binding DeleteToolTip}" ToolTipService.ShowOnDisabled="True"
                                                IsEnabled="{Binding CanDelete}" AutomationProperties.AutomationId="DeleteFolderButton"
                                                Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <!-- 가장 큰 파일 -->
                <Border Style="{StaticResource Card}" Padding="0"
                        Visibility="{Binding ShowLargeFiles, Converter={StaticResource BoolToVisibility}}">
                    <ListBox ItemsSource="{Binding LargeFiles}" ItemContainerStyle="{StaticResource PlainListItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                             AutomationProperties.AutomationId="LargeFileList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Folder}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource HintBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="13"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Button Grid.Column="4" Content="&#xEC50;" Style="{StaticResource IconButton}"
                                            HorizontalAlignment="Right" ToolTip="탐색기에서 위치 열기"
                                            Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding Path}" />
                                    <Button Grid.Column="5" Content="&#xE74D;" Style="{StaticResource IconButton}"
                                            HorizontalAlignment="Right" ToolTip="{Binding DeleteToolTip}" ToolTipService.ShowOnDisabled="True"
                                            IsEnabled="{Binding CanDelete}" AutomationProperties.AutomationId="DeleteFileButton"
                                            Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
