<UserControl x:Class="WinCleaner.App.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28,32,0">

        <!-- 제목 -->
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="새로고침" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
            <StackPanel>
                <TextBlock Text="메모리" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           AutomationProperties.AutomationId="StatusText" />
            </StackPanel>
        </DockPanel>

        <!-- 요약 -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,18,-12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="사용 중" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding UsedText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,8"
                               Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.AutomationId="UsedText" />
                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Style="{StaticResource UsageBar}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="사용 가능" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding AvailableText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="캐시 포함, 바로 내줄 수 있는 양" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="캐시" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding CacheText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="최근에 쓴 파일을 담아 둔 메모리" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="커밋 (확보 / 한도)" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding CommitText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="한도에 가까우면 메모리 부족 오류" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Windows는 남는 메모리를 캐시로 쓰기 때문에 '사용 중'이 높아도 정상일 수 있습니다. 느려졌다면 아래에서 메모리를 많이 쓰는 프로그램부터 확인하세요." />

        <!-- 아래 고정: 대기 목록, 정리 버튼 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="0,14" Margin="-32,0,-32,0">
            <DockPanel Margin="32,0">
                <Button DockPanel.Dock="Right" Content="선택한 프로그램 작업 집합 비우기" Command="{Binding TrimSelectedCommand}"
                        Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="TrimButton" />
                <TextBlock Text="{Binding SelectedText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,14" Padding="18,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="대기 목록 비우기" VerticalAlignment="Center" Margin="16,0,0,0"
                        Command="{Binding PurgeStandbyCommand}" IsEnabled="{Binding CanPurgeStandby}"
                        Style="{StaticResource SecondaryButton}" AutomationProperties.AutomationId="PurgeButton" />
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="고급: 대기 목록 비우기" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Background="{StaticResource BadgeBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="관리자" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="캐시의 대부분을 비웁니다. 게임이 주기적으로 끊기는 것 같은 특별한 경우에만 필요하고, 비운 직후에는 잠깐 느려질 수 있습니다." />
                    <TextBlock Text="관리자 권한으로 실행해야 쓸 수 있습니다." FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource WarningTextBrush}"
                               Visibility="{Binding ShowPurgeElevationWarning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 프로그램 목록 -->
        <DockPanel Margin="0,18,0,0">
            <TextBlock DockPanel.Dock="Top" Text="메모리를 많이 쓰는 프로그램" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,10,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="프로그램" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="RAM 중 비율" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="메모리" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="전용 메모리" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Groups}" ItemContainerStyle="{StaticResource PlainListItem}"
                             Background="Transparent" BorderThickness="0" IsEnabled="{Binding IsIdle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                             AutomationProperties.AutomationId="ProcessList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Title}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="2" Value="{Binding Percent, Mode=OneWay}" Style="{StaticResource UsageBar}"
                                                 VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding WorkingSetText}" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding PrivateText}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>
