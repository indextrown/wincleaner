<UserControl x:Class="WinCleaner.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28,32,24">

        <!-- 제목 -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="32"
                         VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0"
                         ToolTip="이름이나 게시자로 찾기" AutomationProperties.AutomationId="FilterBox" />
                <Button Content="새로고침" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="프로그램 제거" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           AutomationProperties.AutomationId="StatusText" />
            </StackPanel>
        </DockPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,10,0,0"
                     Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding SummaryText}" Style="{StaticResource SecondaryText}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.AutomationId="SummaryText" />
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Microsoft Store에서 받은 앱과 Windows 구성 요소는 이 목록에 없습니다. 설정 > 앱에서 제거하세요." />

        <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
            <ListBox ItemsSource="{Binding VisiblePrograms}" ItemContainerStyle="{StaticResource PlainListItem}"
                     Background="Transparent" BorderThickness="0" IsEnabled="{Binding IsIdle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                     AutomationProperties.AutomationId="ProgramList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Details}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <Button Grid.Column="2" Content="제거" Style="{StaticResource SecondaryButton}" Padding="14,5"
                                    VerticalAlignment="Center" IsEnabled="{Binding CanUninstall}"
                                    ToolTip="{Binding UninstallToolTip}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.AutomationId="UninstallButton"
                                    Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
