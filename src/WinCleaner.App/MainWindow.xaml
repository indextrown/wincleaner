<Window x:Class="WinCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinCleaner.App.ViewModels"
        xmlns:views="clr-namespace:WinCleaner.App.Views"
        Title="WinCleaner" Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleaningViewModel}">
            <views:CleaningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiskUsageViewModel}">
            <views:DiskUsageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizeViewModel}">
            <views:OptimizeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
            <views:MemoryView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 메뉴 -->
        <DockPanel Background="{StaticResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,26,20,26">
                <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="20"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="WinCleaner" FontSize="18" FontWeight="SemiBold" Foreground="White"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" FontSize="11"
                       Foreground="{StaticResource SidebarMutedBrush}" Margin="20,0,20,16" />

            <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedItem}"
                     ItemContainerStyle="{StaticResource NavItem}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Width="30" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 내용 -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Padding="32,10"
                    Background="{StaticResource WarningBackgroundBrush}"
                    BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding ShowElevationWarning, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="관리자 권한으로 다시 시작" Margin="16,0,0,0"
                            Command="{Binding RestartElevatedCommand}" Style="{StaticResource SecondaryButton}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource WarningTextBrush}"
                               Text="일반 권한으로 실행 중입니다. 시스템 영역 정리와 최적화에는 관리자 권한이 필요합니다." />
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding SelectedItem.Page}" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
